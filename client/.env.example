# Optional when the client and API are served from different origins.
# Leave empty when the frontend is reverse-proxied with the API under the same origin.
VITE_API_URL=

# Optional Quran content provider override. Defaults to Al Quran Cloud.
VITE_QURAN_API_URL=https://api.alquran.cloud/v1

# Optional audio CDN override. Defaults to the Islamic Network CDN.
VITE_QURAN_AUDIO_CDN_URL=https://cdn.islamic.network

# Audio fallback quality in kbps. Supported CDN values include 32, 40, 48, 64, 128 and 192.
VITE_QURAN_AUDIO_BITRATE=128
